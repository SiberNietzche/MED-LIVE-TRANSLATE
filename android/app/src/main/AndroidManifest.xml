<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- konuşma modellerini indirmek ve çevrimiçi çeviri için -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- mikrofon ve başka uygulamaların sesini yakalama (ikisi de bu izni ister) -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Bluetooth kulaklık mikrofonu -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- dinlerken ekran kapansa da çalışan servis + bildirimi -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- dinleme yokken kontrol çubuğunu ekranda tutan servis (Android 14+) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- altyazı şeridi diğer uygulamaların üstünde -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- GitHub'dan indirilen yeni sürümü kurmak (kullanıcı onaylar) + arka plan denetimi yeniden başlatmada sürsün -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="MED LIVE TRANSLATE"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".HakkindaEtkinligi"
            android:exported="false" />

        <!-- 6 saatte bir güncelleme denetimi -->
        <service
            android:name=".GuncellemeIsi"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- indirilen güncelleme APK'sını Android'in kurucusuna vermek için -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosyalar"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>

        <activity
            android:name=".KilavuzEtkinligi"
            android:exported="false" />

        <activity
            android:name=".BaslatEtkinligi"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:launchMode="singleInstance"
            android:theme="@style/Tema.Saydam" />

        <service
            android:name=".AltyaziServisi"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Toplantı sırasında diğer uygulamaların üstünde canlı altyazı kontrol çubuğu" />
        </service>

        <!-- görüşme sırasında mikrofonu duyabilmek için (bkz. AltyaziErisilebilirlik); kullanıcı Ayarlar'dan açar -->
        <service
            android:name=".AltyaziErisilebilirlik"
            android:exported="true"
            android:label="@string/erisilebilirlik_ad"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/erisilebilirlik" />
        </service>
    </application>
</manifest>
